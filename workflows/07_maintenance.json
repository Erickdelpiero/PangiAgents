      "parameters": {
        "jsCode": "// message_dedup guarda una huella por cada mensaje procesado, para\n// detectar reintentos del canal. Esa ventana dura segundos: todo lo\n// anterior a 1 hora es basura, no datos. Sin esta limpieza la tabla\n// crece sin límite.\nreturn [{ json: { operation: 'cleanupMessageDedup', params: { hours: 1 } } }];"
      },
