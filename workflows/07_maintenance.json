      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        200,
        80
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Marca como 'expired' las sesiones cuyo expires_at ya pasó. La\n// operación y la función SQL existían desde el MVP pero NINGÚN\n// workflow las llamaba: sin esto, una sesión vencida seguía activa\n// e impedía abrir una nueva (idx_one_active_session_per_user).\n// NO borra filas: solo cambia el estado. La retención de datos es\n// una decisión aparte, pendiente para HIPAA.\nreturn [{ json: { operation: 'cleanupExpiredSessions', params: {} } }];"
      },
      "id": "e1000000-0000-4000-8000-000000000005",
