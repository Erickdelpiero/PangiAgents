    },
    {
      "parameters": {
        "jsCode": "// Resumen legible en el historial de ejecuciones de n8n. No se guarda en\n// base: si más adelante hace falta trazabilidad de mantenimiento, se\n// agrega una tabla de bitácora como la de la sincronización de catálogo.\nconst dedup = $('🗄️ DB — Limpiar Dedup').first().json;\nconst sess  = $input.first().json;\nconst n = (r) => (r && r.success && Array.isArray(r.data) && r.data[0]\n  && r.data[0].result !== undefined) ? r.data[0].result : null;\nreturn [{ json: {\n  ranAt: new Date().toISOString(),\n  dedupRowsDeleted:  n(dedup),\n  dedupOk:           dedup && dedup.success === true,\n  sessionsCleanupOk: sess && sess.success === true\n}}];"
      },
      "id": "e1000000-0000-4000-8000-000000000007",
